{
  "productName": "DynIsland",
  "version": "0.1.0",
  "identifier": "app.dynisland.island",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DynIsland",
        "width": 150,
        "height": 12,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "DynIsland",
        "url": "settings.html",
        "width": 900,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/icon.ico"] }
}
